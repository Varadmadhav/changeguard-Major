PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=changeguard_super_secret_jwt_key_at_least_32_characters_long
# In-memory database fallback is enabled automatically if PostgreSQL is not available
DATABASE_URL=postgresql://changeguard:changeguard_password@localhost:5432/changeguard
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
